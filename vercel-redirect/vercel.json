{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "dest": "https://yu-bazaar-772739041868.us-east4.run.app/",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "Forwarded"
          },
          "args": "proto=https;host=$host"
        }
      ]
    },
    {
      "src": "/(.*)",
      "dest": "https://yu-bazaar-772739041868.us-east4.run.app/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "Forwarded"
          },
          "args": "proto=https;host=$host"
        }
      ]
    }
  ]
}
